# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Production domain. Leave unset on Vercel Preview so each preview URL works.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth. Callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. These people can always sign in and manage the People page.
ADMIN_EMAILS=you@example.com

# Neon, from `vercel integration add neon`. Without it, local dev uses a Postgres file in .data/pglite.
DATABASE_URL=

# Vercel Blob. Without it, files are stored in .data/blobs.
BLOB_READ_WRITE_TOKEN=
